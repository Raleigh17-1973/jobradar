{
  "name": "jobradar",
  "version": "0.1.0",
  "description": "Finds, filters and scores job postings for you from your alerts, searches and company boards. Keeps a private dashboard where you pick jobs and chat with Claude, builds tailored résumés from your own Word résumé, and fills applications in Chrome, stopping for anything only you should do.",
  "author": {
    "name": "Raleigh17-1973"
  },
  "homepage": "https://github.com/Raleigh17-1973/jobradar",
  "repository": "https://github.com/Raleigh17-1973/jobradar",
  "license": "MIT",
  "keywords": [
    "jobs",
    "job search",
    "résumé",
    "applications",
    "career"
  ],
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--browserUrl",
        "http://127.0.0.1:9333",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--screenshotFormat",
        "jpeg",
        "--screenshotMaxWidth",
        "1280",
        "--workspace",
        "${CLAUDE_PROJECT_DIR}"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    }
  }
}
