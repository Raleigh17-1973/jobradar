:root {
  color-scheme: light dark;
  supported-color-schemes: light dark;
}
@media (prefers-color-scheme: dark) {
  body,
  .dm-page {
    background-color: #151515 !important;
  }

  /* Surfaces and text. The descendant sweep also covers the shared footer an=
d legal block. */
  .dm-root,
  .dm-root table,
  .dm-root td,
  .dm-root tr {
    background-color: #222222 !important;
  }
  /* Every descendant, not a tag list: anything unlisted falls through to the=
 browser default. */
  .dm-root,
  .dm-root * {
    color: #d4d2d0 !important;
  }

  /* Hairlines. Every rule in the template is a 1px neutral300 border. */
  .dm-root table,
  .dm-root td {
    border-color: #424242 !important;
  }

  /* Exceptions, in specificity order =E2=80=94 these must NOT read as body t=
ext. */
  .dm-root a {
    color: #5592fd !important;
  }
  /* The button labels sit in an mso-text-raise span, and the blanket rule ab=
ove matches it, so it
     would win over whichever colour the anchor was given. Hand the anchor's =
colour back down. */
  .dm-root a span {
    color: inherit !important;
  }
  /* The job title is a heading first: colouring it like the other links cost=
s the hierarchy. */
  .dm-root .dm-title {
    color: #f3f2f1 !important;
  }
  /* Same reasoning for the profile field labels: they are labels that happen=
 to be tappable, and the
     underline already carries the affordance. Blue would put four of them in=
 the row of a wash. */
  .dm-root .dm-plain-link {
    color: #d4d2d0 !important;
  }
  .dm-root .dm-muted,
  .dm-root .dm-muted span {
    color: #949494 !important;
  }
  /* IFL's dark action pair: the hand-picked blue it replaced measured 4.00:1=
, under AA. */
  .dm-root .dm-btn {
    background-color: #5592fd !important;
    border-color: #5592fd !important;
  }
  .dm-root .dm-btn a {
    color: #151515 !important;
  }
  /* Brand-header wordmark. Unscoped on purpose: that header renders outside =
.dm-root. */
  /* Our own footer (redesign/footer.tsx) is inside .dm-root. These rules win=
 only because they are
     equal-specificity with the .dm-root ones above and come later, so keep t=
hem last in this block. */
  .dm-footer,
  .dm-footer table,
  .dm-footer td {
    background-color: #151515 !important;
  }
  .dm-footer .dm-muted,
  .dm-footer p {
    color: #949494 !important;
  }
  .dm-footer a {
    color: #5592fd !important;
  }
  /* Overrides the blanket p rule: the app-download heading is not fine print=
. */
  .dm-footer .dm-strong {
    color: #f3f2f1 !important;
  }
  .dm-hide {
    display: none !important;
  }
  .dm-show {
    display: block !important;
  }
  /* The social row is a line of inline images, so its reveal cannot use the =
block .dm-show. */
  .dm-social-dark {
    display: inline-block !important;
  }

  /* Profile chips: the blanket .dm-root td fill would otherwise erase their =
grounds. */
  .dm-root .dm-chip-alert td {
    background-color: #5f0c10 !important;
  }
  .dm-root .dm-chip-alert span {
    color: #fc9597 !important;
  }
  .dm-root .dm-chip-warn td {
    background-color: #482708 !important;
  }
  .dm-root .dm-chip-warn span {
    color: #f39e63 !important;
  }
  /* Dark ground with light text, like the other two chips. The pill above ke=
eps its light ground
     because it has to stand out among grey pills; a chip only annotates the =
line it sits under. */
  .dm-root .dm-chip-match td {
    background-color: #0c3614 !important;
  }
  .dm-root .dm-chip-match span {
    color: #73c47e !important;
  }
  /* Inner tables carry no fill: the radius sits on the cell above them. */
  .dm-root .dm-chip-alert table,
  .dm-root .dm-chip-alert tr,
  .dm-root .dm-chip-warn table,
  .dm-root .dm-chip-warn tr,
  .dm-root .dm-chip-match table,
  .dm-root .dm-chip-match tr {
    background-color: transparent !important;
  }

  /* Neutral glyphs are drawn dark, so they disappear on the dark surface. */
  .dm-root .dm-icon {
    filter: invert(1);
  }


  /* Employer logos are supplied for light backgrounds, so the tile behind on=
e stays white. */
  .dm-root .dm-logo {
    background-color: #ffffff !important;
  }
  /* Dark ground with light text, like the pills beside it. A light green amo=
ng dark ones did not
     read as emphasis, it read as unstyled. Green still separates it from the=
 neutral pills. */
  .dm-root .dm-tag-match {
    background-color: #0c3614 !important;
  }
  .dm-root .dm-tag-match span {
    color: #73c47e !important;
  }
  .dm-root .dm-tag {
    background-color: #2d2d2d !important;
  }
  /* Descendants stay transparent: the radius sits on the outer table, which =
carries the fill. */
  .dm-root .dm-tag table,
  .dm-root .dm-tag tr,
  .dm-root .dm-tag td,
  .dm-root .dm-tag-match table,
  .dm-root .dm-tag-match tr,
  .dm-root .dm-tag-match td {
    background-color: transparent !important;
  }
}
