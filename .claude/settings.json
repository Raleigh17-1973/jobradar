{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./jr:*)",
      "Edit(./data/**)",
      "Edit(./applications/**)",
      "WebSearch",
      "mcp__claude-artifacts",
      "mcp__claude-in-chrome",
      "mcp__chrome-devtools",
      "ArtifactData",
      "Artifact",
      "PushNotification"
    ],
    "ask": [
      "Edit(./config/truth.md)"
    ],
    "deny": [
      "Bash(security find-generic-password:*)"
    ]
  }
}
